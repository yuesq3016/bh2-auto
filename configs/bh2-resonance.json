// 崩坏学园2 · 共鸣屋:刷新 + 目标自动购买
//
// ===========================================================================
//  ↓↓↓  需要改的只有这一处:把想刷到的装备名写进 watchlist  ↓↓↓
// ===========================================================================
//
// 规则(按你的要求):
//   - 每轮读取 6 个格子的名字 + 是否「已拥有」
//   - 如果出现 watchlist 里的装备 **且未拥有**  -> 先购买,然后继续刷新
//   - 如果出现了但已拥有 -> 只记录,不买,继续刷新
//   - 刷新次数用完就停(会用「剩余次数」验证每次刷新真的消耗了)
//
// 名字可以用**部分匹配**:写「医疗精灵」能匹配到「医疗精灵·小蜜蜂」。
// 万一 OCR 漏字,写短一点更保险(比如写「玛雅」而不是「玛雅黄金翼」)。
//
// 用法:
//   python -m simauto validate --config configs\bh2-resonance.json
//   python -m simauto run --config configs\bh2-resonance.json --dry-run   # 只看不点
//   python -m simauto run --config configs\bh2-resonance.json

{
  "name": "崩坏学园2 · 共鸣屋刷新",
  "mode": "once",

  "reference_resolution": [1280, 720],
  "window": {},

  "capture": {
    "backend": "adb",
    "address": "127.0.0.1:16384",
    "adb_input": "maatouch",
    "rotation": 0
  },

  "defaults": { "check_every": 0.05, "click_jitter": 3 },

  "recognizers": {
    // 界面锚点:确认在共鸣屋
    "resonanceTab": {
      "method": "ocr",
      "text": ["共鸣屋"],
      "roi": [20, 270, 150, 90],
      "threshold": 0.6
    },
    "refreshCount": {
      "method": "ocr",
      "text": ["剩余次数"],
      "roi": [760, 110, 340, 90],
      "threshold": 0.5
    }
  },

  "steps": [
    { "action": "screenshot", "tag": "01_resonanceBefore" },
    { "action": "log", "message": "=== 共鸣屋:按 watchlist 刷新并购买 ===" },

    {
      "action": "resonance_refresh",

      // =====================================================================
      //  ★ 购买名单:来自「13.0版本垃圾屋萌新推荐表」★
      //  规则:命中名单里的装备 **且未拥有**  -> 购买;其他未拥有的一律不买。
      //  名字用部分匹配,所以 OCR 偶尔漏字也能命中。
      //  要临时排除某个,把它注释掉或删掉即可。
      // =====================================================================
      "watchlist": [
        // ---- 难点装备:优先刷、优先换 ----
        "地脉制式便携终端",
        "渴求之镰",
        "恰卡纳",
        "rh",
        "未知的纹章",
        "深渊人形",
        "欧米图之祭",
        "奈亚拉托提普",

        // ---- 割草体系 / 秘境专场 ----
        "盛夏清忆",
        "再见猫耳",
        "愿望杯",
        "芙洛拉的金簪",
        "华彩人形",
        "达盖尔的记录",
        "荒野枪客",
        "炎夏苏打",

        // ---- 星灵专属:巨蟹套 ----
        "猫猫快乐球",
        "尤姆·卡克斯的赐福",
        "静籁永恒",
        // ---- 星灵专属:双鱼套 ----
        "拉冬的守望",
        "提丰巨人之握",
        // ---- 星灵专属:摩羯套 / 水瓶套 ----
        "时之幻象",
        "罗生门",
        // ---- 星灵专属:娃娃套 ----
        "红贽人形",
        "流浪迷魂",

        // ---- 通用但下水道(优先级最低)----
        "真夏夜夜",
        "阿斯蒙蒂斯的诱惑",
        "瓦尔哈拉回音",
        "赫柏的飨宴"
      ],

      // 刷新按钮位置(实测蓝色圆形按钮中心;纯图标,OCR 读不到所以给坐标)
      "refresh_point": [1088, 153],

      // 最多消耗几次刷新(当前界面显示"剩余次数 3 次")
      "max_refresh": 3,

      // true = 命中未拥有的目标就买;false = 只报告不买
      "buy": true,

      // 余额保护:共鸣币不够就不买(避免买到一半失败)
      "currency_roi": [330, 120, 230, 60],
      "currency_min": 6000,

      "settle": 2.5
    },

    { "action": "screenshot", "tag": "02_resonanceAfter" },
    { "action": "log", "message": "=== 共鸣屋处理完成 ===" }
  ],

  "session_dir": "sessions",
  "max_seconds": 600
}
